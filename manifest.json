{
  "manifest_version": 3,
  "name": "RP DEV | Clock",
  "version": "1.0.0",
  "description": "A stopwatch, live clock, and alarm in your browser.",
  "permissions": [
    "alarms",
    "notifications",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "RP DEV | Clock",
    "default_popup": "popup.html"
  }
}
